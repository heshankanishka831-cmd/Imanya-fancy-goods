# Server Configuration
SERVER_PORT=8081
SERVER_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=distribution_management
DB_SSLMODE=disable

# Authentication
JWT_SECRET=super-secret-key-change-in-production-min-32-chars-long!
JWT_EXPIRATION_HOURS=24

# WhatsApp Integration
WHATSAPP_STORE_NUMBER=94766611606
WHATSAPP_PHONE_NUMBER=94766611606
WHATSAPP_MESSAGE_PREFIX=Hello Imanya Fancy Goods Team, I would like to confirm my customer order:

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Delivery (Gmail SMTP with Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=yourbusiness@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_NAME=Imanya Fancy Goods
